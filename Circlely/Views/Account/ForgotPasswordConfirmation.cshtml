@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Check Your Email • Circlely</title>

    <link rel="stylesheet"
          href="~/css/Register.css"
          asp-append-version="true" />
</head>

<body>

    <main class="register-container">

        <section class="register-card">

            <div class="logo">
                Circlely
            </div>

            <p class="subtitle">
                Check your email
            </p>

            <div class="email-message">

                <p>
                    If an account exists with the email
                    address you entered, we have sent
                    a password reset link.
                </p>

                <p>
                    Open your email and click the
                    <strong>Reset Password</strong>
                    button.
                </p>

                <p>
                    If you don't see the email,
                    check your spam or junk folder.
                </p>

            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="register-button login-button">
                Back to Login
            </a>

        </section>

    </main>

</body>

</html>