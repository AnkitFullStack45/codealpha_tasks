@model Circlely.ViewModels.PostViewModel

@{
    ViewData["Title"] = "Create Post";
}

<div class="container mt-5">

    <div class="card shadow-sm p-4">

        <h2 class="mb-4">Create Post</h2>

        <form asp-controller="Home"
              asp-action="CreatePost"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label asp-for="Content" class="form-label">
                    Caption
                </label>

                <textarea asp-for="Content"
                          class="form-control"
                          rows="4"
                          placeholder="What's on your mind?"></textarea>

                <span asp-validation-for="Content"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Image" class="form-label">
                    Select Image
                </label>

                <input asp-for="Image"
                       type="file"
                       class="form-control"
                       accept="image/*" />

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Upload Post
            </button>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
