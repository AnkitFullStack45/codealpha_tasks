@{
    ViewData["Title"] = "Contact Us";
    Layout = "_Layout";
}

<div class="container py-5" style="background-color:coral">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">
            <i class="bi bi-envelope-paper-fill"></i> Contact Us
        </h1>
        <p class="text-dark fs-5">
            We'd love to hear from you! If you have any questions, suggestions, or feedback about our Image Gallery, please get in touch.
        </p>
    </div>

    <div class="row g-4">

        <!-- Contact Information -->
        <div class="col-lg-5">
            <div class="card shadow-lg border-2 rounded-4 h-200">
                <div class="card-body p-4">

                    <h3 class="text-primary mb-4">
                        <i class="bi bi-info-circle-fill"></i> Contact Information
                    </h3>

                    <div class="mb-4">
                        <h5><i class="bi bi-geo-alt-fill text-danger"></i> Address</h5>
                        <p class="text-muted">
                            Image Gallery Office<br />
                            Ghaziabad 201206
                 
                        </p>
                    </div>

                    <div class="mb-4">
                        <h5><i class="bi bi-telephone-fill text-success"></i> Phone</h5>
                        <p class="text-muted">
                            +91 952045038
                        </p>
                    </div>

                    <div class="mb-4">
                        <h5><i class="bi bi-envelope-fill text-primary"></i> Email</h5>
                        <p class="text-muted">
                            ankitk66135@gmail.com
                        </p>
                    </div>

                    <div>
                        <h5><i class="bi bi-share-fill"></i> Follow Us</h5>

                        <a href="https://www.linkedin.com/in/ankit-kumar-a28229412" class="btn btn-outline-info me-2">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="https://www.instagram.com/mr.ankit_baghel45/" class="btn btn-outline-danger me-2">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://github.com/AnkitFullStack45" class="btn btn-outline-dark">
                            <i class="bi bi-github"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">
            <div class="card shadow-lg border-2 rounded-4">
                <div class="card-body p-4">

                    <h3 class="text-primary mb-4">
                        <i class="bi bi-chat-left-text-fill"></i> Send Us a Message
                    </h3>

                    <form>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Full Name</label>
                                <input type="text" class="form-control" placeholder="Enter your name">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Email Address</label>
                                <input type="email" class="form-control" placeholder="Enter your email">
                            </div>

                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Subject</label>
                            <input type="text" class="form-control" placeholder="Enter subject">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Message</label>
                            <textarea rows="6" class="form-control" placeholder="Write your message here..."></textarea>
                        </div>

                        <button class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-send-fill"></i> Send Message
                        </button>

                        <button type="reset" class="btn btn-outline-secondary btn-lg">
                            Reset
                        </button>

                    </form>

                </div>
            </div>
        </div>

    </div>

    <!-- FAQ Section -->
    <div class="mt-5">
        <div class="card shadow border-1 border-grey rounded-4">
            <div class="card-body p-4">

                <h3 class="text-primary mb-4">
                    <i class="bi bi-question-circle-fill"></i> Frequently Asked Questions
                </h3>

                <div class="mb-3">
                    <h5>Can I download images?</h5>
                    <p class="text-muted">
                        Download availability depends on the permissions provided for each image.
                    </p>
                </div>

                <div class="mb-3">
                    <h5>Can I upload my own images?</h5>
                    <p class="text-muted">
                        Currently, image uploads are managed by the website administrator.
                    </p>
                </div>

                <div>
                    <h5>How can I report an issue?</h5>
                    <p class="text-muted">
                        Use the contact form above or email our support team with details of the issue.
                    </p>
                </div>

            </div>
        </div>
    </div>

</div>
