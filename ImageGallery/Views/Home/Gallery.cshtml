@{
    ViewData["Title"] = "Gallery";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row text-center">
            <div class="col-lg-12 col-md-12 col-sm-12 text-center">
            <h1 class="mb-1 text-center">Explore beautiful Moments</h1>
            <p class="text-center" style="font-size:1.25rem; font-weight:500; opacity:0.7;">A Collection of my Favourite photographs</p>
            </div>
    </div>
    <section class="gallery-header">
        <div class="category-buttons">
            <button class="category-btn active" data-category="all">
                All
            </button>
            <button class="category-btn" data-category="nature">
                🌿 Nature
            </button>
            <button class="category-btn" data-category="mountains">
                🏔️ Mountains
            </button>
            <button class="category-btn" data-category="water">
                💧 Water
            </button>
            <button class="category-btn" data-category="city">
                🏢 City
            </button>
            <button class="category-btn" data-category="hills">
                🌌 Hills
            </button>
        </div>
    </section>
    <div id="lightbox" class="lightbox" >
        <button id="closeLightbox" class="close-btn">❌</button>
        <button id="previousImage" class="prev-btn">◀</button>
        <img id="lightboxImage" src="" alt="preview">
        <button id="nextImage" class="next-btn">▶</button>
    </div>
    <div class="row text-center">
        @for (int i = 1; i <= 52; i++)
        {
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="card shadow-sm border-0 gallery-card">

                    <img src="~/images/gallery/img@(i).jpg"
                         class="card-img-top gallery-img"
                         alt="Gallery Image @i" 
                         data-index="@i"
                         style="height:250px; width:100%; object-fit:cover;">
                </div>
            </div>
        }
    </div>
</div>