@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card shadow border-3 border-dark rounded-4">
        <div class="card-body p-5" style="background-color:darksalmon">

            <h1 class="text-center text-primary fw-bold mb-4">
                <i class="bi bi-shield-lock-fill"></i> Privacy Policy
            </h1>

            <p class="lead text-center">
                We value your privacy and are committed to protecting the information you share while using our Image Gallery website.
            </p>

            <hr>

            <h4 class="mt-4">1. Image Usage</h4>
            <p>
                The images displayed in this gallery are intended for viewing and informational purposes only.
                Unauthorized copying, redistribution, or commercial use of any image is prohibited unless permission has been granted by the owner.
            </p>

            <h4 class="mt-4">2. Personal Information</h4>
            <p>
                Our Image Gallery does not collect personal information from visitors unless it is voluntarily provided through a contact form or other communication methods.
            </p>

            <h4 class="mt-4">3. Cookies</h4>
            <p>
                This website may use cookies to improve your browsing experience and enhance website performance.
                Cookies do not collect personally identifiable information.
            </p>

            <h4 class="mt-4">4. Third-Party Content</h4>
            <p>
                Some images or external links may lead to third-party websites.
                We are not responsible for the privacy practices or content of those websites.
            </p>

            <h4 class="mt-4">5. Copyright</h4>
            <p>
                All images remain the property of their respective owners.
                Please respect copyright and intellectual property rights when viewing or sharing gallery content.
            </p>

            <h4 class="mt-4">6. Changes to This Policy</h4>
            <p>
                We may update this Privacy Policy from time to time.
                Any changes will be posted on this page with immediate effect.
            </p>

            <h4 class="mt-4">7. Contact</h4>
            <p>
                If you have any questions about this Privacy Policy or the use of images on this website,
                please contact the website administrator.
            </p>

            <hr>

            <p class="text-center text-dark mb-0">
                &copy; @DateTime.Now.Year Image Gallery. All Rights Reserved.
            </p>

        </div>
    </div>
</div>
