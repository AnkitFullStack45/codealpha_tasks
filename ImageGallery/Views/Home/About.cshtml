@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<div class="container py-5 bg-warning" style="font-family:Arial, Helvetica, sans-serif">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">
            <i class="bi bi-images"></i> About Image Gallery
        </h1>
        <p class="lead text-black">
            Discover, explore, and enjoy a carefully curated collection of beautiful images.
        </p>
    </div>

    <!-- About -->
    <div class="card shadow-lg border-0 rounded-4 mb-5">
        <div class="card-body p-5">
            <h2 class="text-primary mb-3">Who We Are</h2>
            <p class="text-dark">
                Image Gallery is a modern web application designed to organize and display
                high-quality images in a simple, attractive, and user-friendly interface.
                Whether you're browsing nature, architecture, travel, wildlife, or creative
                photography, our gallery provides a smooth and enjoyable viewing experience.
            </p>

            <p class="text-dark">
                Our goal is to make discovering images easy through a clean layout,
                responsive design, and intuitive navigation across all devices.
            </p>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="row g-4 mb-5">

        <div class="col-md-6">
            <div class="card h-100 shadow border-0 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-bullseye display-4 text-primary"></i>
                    <h3 class="mt-3">Our Mission</h3>
                    <p class="text-dark">
                        To provide an elegant platform where users can explore inspiring
                        image collections with a fast, responsive, and visually appealing experience.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow border-0 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="bi bi-eye-fill display-4 text-success"></i>
                    <h3 class="mt-3">Our Vision</h3>
                    <p class="text-muted">
                        To become a trusted destination for showcasing creative,
                        artistic, and informative image collections for everyone.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Features -->
    <div class="card shadow-lg border-0 rounded-4 mb-5">
        <div class="card-body p-5">

            <h2 class="text-primary mb-4 text-center">
                <i class="bi bi-stars"></i> Why Choose Our Gallery?
            </h2>

            <div class="row text-center">

                <div class="col-md-4 mb-4">
                    <i class="bi bi-phone display-5 text-primary"></i>
                    <h5 class="mt-3">Responsive Design</h5>
                    <p class="text-muted">
                        Optimized for desktops, tablets, and mobile devices.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <i class="bi bi-lightning-charge-fill display-5 text-warning"></i>
                    <h5 class="mt-3">Fast Performance</h5>
                    <p class="text-muted">
                        Images load quickly for a smooth browsing experience.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <i class="bi bi-grid-3x3-gap-fill display-5 text-success"></i>
                    <h5 class="mt-3">Organized Gallery</h5>
                    <p class="text-muted">
                        Well-structured image collections that are easy to explore.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <i class="bi bi-shield-check display-5 text-danger"></i>
                    <h5 class="mt-3">Secure Platform</h5>
                    <p class="text-muted">
                        Designed with privacy and secure browsing in mind.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <i class="bi bi-palette-fill display-5 text-info"></i>
                    <h5 class="mt-3">Modern Interface</h5>
                    <p class="text-muted">
                        A clean, elegant design that highlights every image beautifully.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <i class="bi bi-search display-5 text-secondary"></i>
                    <h5 class="mt-3">Easy Navigation</h5>
                    <p class="text-muted">
                        Browse image collections quickly with a simple and intuitive layout.
                    </p>
                </div>

            </div>

        </div>
    </div>

    <!-- Closing -->
    <div class="card shadow border-0 rounded-4 bg-primary text-white">
        <div class="card-body text-center p-5">

            <h2>Explore. Discover. Enjoy.</h2>

            <p class="lead mt-3">
                Thank you for visiting our Image Gallery. We hope you enjoy exploring
                our growing collection of beautiful and inspiring images.
            </p>

        </div>
    </div>

</div>