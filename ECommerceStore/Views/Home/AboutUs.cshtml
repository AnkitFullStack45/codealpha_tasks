@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">

    <!-- Background Atmosphere -->
    <div class="about-orb about-orb-1"></div>
    <div class="about-orb about-orb-2"></div>
    <div class="about-orb about-orb-3"></div>


    <!-- =========================
         HERO
    ========================== -->

    <section class="about-hero">

        <div class="about-container">

            <div class="about-badge">
                <span></span>
                Welcome to Ankit Kart
            </div>

            <h1>
                Everything you need.
                <strong>All in one place.</strong>
            </h1>

            <p>
                Ankit Kart is a modern e-commerce platform built to
                bring technology, lifestyle, fitness, fashion and
                everyday essentials together in one seamless
                shopping experience.
            </p>

            <div class="about-hero-buttons">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="about-primary-btn">
                    Explore Products
                    <span>→</span>
                </a>

                <a href="#our-story"
                   class="about-glass-btn">
                    Our Story
                </a>

            </div>

        </div>

    </section>


    <!-- =========================
         CATEGORIES
    ========================== -->

    <section class="about-categories">

        <div class="about-container">

            <div class="about-section-heading">

                <span>WHAT WE OFFER</span>

                <h2>
                    One store.
                    <strong>Many possibilities.</strong>
                </h2>

            </div>


            <div class="about-category-grid">

                <div class="about-category-card">
                    <div class="about-category-icon">💻</div>
                    <h3>Laptops</h3>
                    <p>
                        Powerful laptops for work, study,
                        creativity and entertainment.
                    </p>
                </div>


                <div class="about-category-card">
                    <div class="about-category-icon">📱</div>
                    <h3>Mobile Phones</h3>
                    <p>
                        Stay connected with the latest
                        smartphones and mobile technology.
                    </p>
                </div>


                <div class="about-category-card">
                    <div class="about-category-icon">🎧</div>
                    <h3>Accessories</h3>
                    <p>
                        Essential accessories to complete
                        your digital lifestyle.
                    </p>
                </div>


                <div class="about-category-card">
                    <div class="about-category-icon">🏋️</div>
                    <h3>Gym & Fitness</h3>
                    <p>
                        Equipment and essentials to support
                        your fitness journey.
                    </p>
                </div>


                <div class="about-category-card">
                    <div class="about-category-icon">🍔</div>
                    <h3>Food</h3>
                    <p>
                        Everyday food and lifestyle products
                        delivered with convenience.
                    </p>
                </div>


                <div class="about-category-card">
                    <div class="about-category-icon">👕</div>
                    <h3>Clothing</h3>
                    <p>
                        Everyday fashion and clothing
                        for different styles.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         OUR STORY
    ========================== -->

    <section id="our-story"
             class="about-story">

        <div class="about-container">

            <div class="about-section-heading">

                <span>OUR STORY</span>

                <h2>
                    Built to make
                    <strong>shopping simple.</strong>
                </h2>

                <p>
                    Ankit Kart brings multiple shopping
                    categories together under one roof.
                </p>

            </div>


            <div class="about-story-grid">

                <div class="about-story-card about-glass">

                    <small>01 — OUR VISION</small>

                    <h3>
                        A better way to shop online.
                    </h3>

                    <p>
                        We believe online shopping should be
                        simple, convenient and enjoyable.
                        That's why Ankit Kart brings technology,
                        fashion, fitness, food and everyday
                        essentials together on one platform.
                    </p>

                    <p>
                        Our goal is to continuously improve
                        the shopping experience through
                        thoughtful design and modern technology.
                    </p>

                </div>


                <div class="about-story-card about-story-highlight">

                    <div class="about-quote">
                        “
                    </div>

                    <h3>
                        Everything you need.
                        All in one place.
                    </h3>

                    <span>
                        — ANKIT KART
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         STATS
    ========================== -->

    <section class="about-stats">

        <div class="about-container">

            <div class="about-stats-grid">

                <div class="about-stat-card">
                    <strong>6+</strong>
                    <span>Shopping Categories</span>
                </div>

                <div class="about-stat-card">
                    <strong>100+</strong>
                    <span>Products</span>
                </div>

                <div class="about-stat-card">
                    <strong>24/7</strong>
                    <span>Online Shopping</span>
                </div>

                <div class="about-stat-card">
                    <strong>1</strong>
                    <span>Complete Marketplace</span>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         WHY ANKIT KART
    ========================== -->

    <section class="about-values">

        <div class="about-container">

            <div class="about-section-heading">

                <span>WHY ANKIT KART</span>

                <h2>
                    Designed around
                    <strong>you.</strong>
                </h2>

            </div>


            <div class="about-values-grid">

                <div class="about-value-card">

                    <div class="about-value-icon">
                        ✦
                    </div>

                    <h3>Quality</h3>

                    <p>
                        We aim to provide products that offer
                        quality, reliability and real value.
                    </p>

                </div>


                <div class="about-value-card">

                    <div class="about-value-icon">
                        ⚡
                    </div>

                    <h3>Convenience</h3>

                    <p>
                        Multiple categories and products
                        available through one simple platform.
                    </p>

                </div>


                <div class="about-value-card">

                    <div class="about-value-icon">
                        ♡
                    </div>

                    <h3>Customer First</h3>

                    <p>
                        We put the customer experience at
                        the center of everything we build.
                    </p>

                </div>


                <div class="about-value-card">

                    <div class="about-value-icon">
                        ◉
                    </div>

                    <h3>Variety</h3>

                    <p>
                        From laptops and mobiles to clothes,
                        food and fitness products.
                    </p>

                </div>


                <div class="about-value-card">

                    <div class="about-value-icon">
                        ↗
                    </div>

                    <h3>Innovation</h3>

                    <p>
                        Modern technology and thoughtful design
                        power our shopping experience.
                    </p>

                </div>


                <div class="about-value-card">

                    <div class="about-value-icon">
                        ∞
                    </div>

                    <h3>Growing Together</h3>

                    <p>
                        We continuously improve Ankit Kart
                        based on the needs of our customers.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         FINAL CTA
    ========================== -->

    <section class="about-final">

        <div class="about-container">

            <div class="about-final-card about-glass">

                <span>
                    THE ANKIT KART EXPERIENCE
                </span>

                <h2>
                    Discover something
                    <strong>you'll love.</strong>
                </h2>

                <p>
                    Explore our growing collection of products
                    across technology, fitness, fashion, food
                    and more.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="about-primary-btn">
                    Start Shopping
                    <span>→</span>
                </a>

            </div>

        </div>

    </section>

</div>
