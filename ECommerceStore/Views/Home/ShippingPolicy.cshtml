@{
    ViewData["Title"] = "Shipping Policy";
}

<div class="shipping-page">

    <div class="shipping-header">
        <h1>Shipping Policy</h1>
        <p>Everything you need to know about shipping and delivery.</p>
    </div>

    <div class="shipping-container">

        <div class="shipping-card">

            <div class="shipping-content">

                <section class="shipping-section">
                    <h3>1. Order Processing</h3>
                    <p>
                        Once you place an order, we begin processing it as soon
                        as possible. Orders are generally processed within
                        1–2 business days.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>2. Shipping Time</h3>
                    <p>
                        Standard delivery usually takes approximately
                        3–7 business days after your order has been processed.
                        Delivery times may vary depending on your location
                        and courier service.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>3. Shipping Charges</h3>
                    <p>
                        We currently offer free standard shipping on eligible
                        orders. Any applicable shipping charges will be clearly
                        displayed during checkout before you place your order.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>4. Delivery Areas</h3>
                    <p>
                        We deliver to most locations across India. Delivery
                        availability may depend on the serviceability of your
                        PIN code.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>5. Order Tracking</h3>
                    <p>
                        Once your order has been shipped, you may receive
                        tracking information through the contact details
                        provided during checkout.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>6. Delayed or Lost Orders</h3>
                    <p>
                        Although we work with reliable delivery partners,
                        unexpected delays can sometimes occur due to weather,
                        holidays, technical issues, or other circumstances.
                        If your order is significantly delayed, please contact
                        our support team.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>7. Incorrect Shipping Address</h3>
                    <p>
                        Please make sure your shipping address and PIN code are
                        correct before placing your order. We may not be able
                        to change the delivery address once the order has been
                        shipped.
                    </p>
                </section>

                <section class="shipping-section">
                    <h3>8. Damaged Package</h3>
                    <p>
                        If your package appears damaged when delivered, please
                        inspect the product carefully and contact our support
                        team as soon as possible with photographs and order
                        details.
                    </p>
                </section>

                <section class="shipping-section last-section">
                    <h3>9. Contact Us</h3>
                    <p>
                        If you have questions about shipping or delivery,
                        please contact our customer support team.
                    </p>
                </section>

            </div>

        </div>

    </div>

</div>