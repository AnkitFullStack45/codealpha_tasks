@{
    ViewData["Title"] = "Return Policy";
}

<div class="return-policy-page">

    <!-- Header -->
    <div class="return-policy-header">
        <h1>Return Policy</h1>
        <p>
            Our policy for returns, replacements, and refunds.
        </p>
    </div>

    <!-- Policy Container -->
    <div class="return-policy-container">

        <div class="return-policy-card">

            <!-- 1 -->
            <section class="policy-section">
                <h2>1. Return Eligibility</h2>

                <p>
                    Products may be eligible for return or replacement
                    depending on the product category and condition.
                    Please make sure the product is unused and kept in
                    its original packaging.
                </p>
            </section>


            <!-- 2 -->
            <section class="policy-section">
                <h2>2. Return Period</h2>

                <p>
                    Return requests should generally be submitted within
                    7 days of receiving your order. Requests submitted
                    after this period may not be accepted.
                </p>
            </section>


            <!-- 3 -->
            <section class="policy-section">
                <h2>3. Product Condition</h2>

                <p>
                    To be eligible for a return, the product should be in
                    its original condition with all accessories, manuals,
                    packaging, labels, and other included items.
                </p>
            </section>


            <!-- 4 -->
            <section class="policy-section">
                <h2>4. Damaged or Defective Products</h2>

                <p>
                    If you receive a damaged, defective, or incorrect
                    product, please contact our support team as soon as
                    possible. You may be asked to provide photographs or
                    other information to help us investigate the issue.
                </p>
            </section>


            <!-- 5 -->
            <section class="policy-section">
                <h2>5. Non-Returnable Products</h2>

                <p>
                    Products that have been physically damaged, modified,
                    misused, or are missing original accessories may not
                    qualify for return or replacement.
                </p>
            </section>


            <!-- 6 -->
            <section class="policy-section">
                <h2>6. Refunds</h2>

                <p>
                    Once the returned product has been received and
                    inspected, eligible refunds will be processed using
                    the applicable payment method or refund process.
                    Processing time may vary depending on the payment
                    provider.
                </p>
            </section>


            <!-- 7 -->
            <section class="policy-section">
                <h2>7. Replacement</h2>

                <p>
                    Where applicable, defective or incorrect products may
                    be replaced with the same or an equivalent product,
                    subject to availability.
                </p>
            </section>


            <!-- 8 -->
            <section class="policy-section">
                <h2>8. Return Shipping</h2>

                <p>
                    Return shipping arrangements may depend on the reason
                    for the return. If the product is confirmed to be
                    defective, damaged, or incorrectly delivered, we may
                    provide appropriate return assistance.
                </p>
            </section>


            <!-- 9 -->
            <section class="policy-section">
                <h2>9. How to Request a Return</h2>

                <p>
                    To request a return or replacement, contact our
                    customer support team with your order number,
                    product details, and a description of the issue.
                </p>
            </section>


            <!-- 10 -->
            <section class="policy-section last-section">
                <h2>10. Contact Us</h2>

                <p>
                    If you have any questions regarding returns,
                    replacements, or refunds, please contact our customer
                    support team.
                </p>
            </section>

        </div>

    </div>

</div>