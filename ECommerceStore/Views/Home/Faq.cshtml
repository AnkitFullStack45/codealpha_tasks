@{
    ViewData["Title"] = "Frequently Asked Questions";
}

<div class="faq-page">

    <!-- Page Header -->
    <div class="faq-header">
        <h1>Frequently Asked Questions</h1>
        <p>
            Find answers to some of the most common questions about our store.
        </p>
    </div>

    <!-- FAQ Container -->
    <div class="faq-container">

        <div class="faq-card">

            <div class="faq-card-body">

                <div class="faq-accordion" id="faqAccordion">

                    <!-- FAQ 1 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq1"
                                    aria-expanded="true"
                                    aria-controls="faq1">
                                How can I place an order?
                            </button>
                        </h2>

                        <div id="faq1"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Browse our products, select the product
                                you want, and click the "Add to Cart"
                                button. You can then review your cart and
                                proceed to checkout.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 2 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq2"
                                    aria-expanded="false"
                                    aria-controls="faq2">
                                How can I add a product to my cart?
                            </button>
                        </h2>

                        <div id="faq2"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Open the product you want to purchase and
                                click the "Add to Cart" button. The product
                                will be added to your shopping cart.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 3 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq3"
                                    aria-expanded="false"
                                    aria-controls="faq3">
                                How can I change the quantity of a product?
                            </button>
                        </h2>

                        <div id="faq3"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Open your shopping cart and use the plus
                                and minus buttons next to the product to
                                increase or decrease its quantity.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 4 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq4"
                                    aria-expanded="false"
                                    aria-controls="faq4">
                                How long does delivery take?
                            </button>
                        </h2>

                        <div id="faq4"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Standard delivery generally takes around
                                3–7 business days after your order has
                                been processed. Delivery times may vary
                                depending on your location.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 5 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq5"
                                    aria-expanded="false"
                                    aria-controls="faq5">
                                Do you offer free shipping?
                            </button>
                        </h2>

                        <div id="faq5"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                We currently offer free standard shipping
                                on eligible orders. Any applicable charges
                                will be displayed during checkout.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 6 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq6"
                                    aria-expanded="false"
                                    aria-controls="faq6">
                                Can I return a product?
                            </button>
                        </h2>

                        <div id="faq6"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Eligible products can generally be returned
                                within the specified return period.
                                Products should be unused and in their
                                original condition and packaging.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 7 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq7"
                                    aria-expanded="false"
                                    aria-controls="faq7">
                                What should I do if I receive a damaged product?
                            </button>
                        </h2>

                        <div id="faq7"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Contact our customer support team as soon
                                as possible. Please keep the original
                                packaging and provide photographs of the
                                damaged product if requested.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 8 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq8"
                                    aria-expanded="false"
                                    aria-controls="faq8">
                                How can I track my order?
                            </button>
                        </h2>

                        <div id="faq8"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Once your order has been shipped, tracking
                                information can be provided through the
                                contact details associated with your order.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 9 -->
                    <div class="faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq9"
                                    aria-expanded="false"
                                    aria-controls="faq9">
                                What payment methods are available?
                            </button>
                        </h2>

                        <div id="faq9"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                Available payment methods are displayed
                                during checkout and may vary depending
                                on the payment service being used.
                            </div>

                        </div>

                    </div>


                    <!-- FAQ 10 -->
                    <div class="faq-item last-faq-item">

                        <h2 class="faq-question">
                            <button class="accordion-button faq-button collapsed fw-bold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq10"
                                    aria-expanded="false"
                                    aria-controls="faq10">
                                How can I contact customer support?
                            </button>
                        </h2>

                        <div id="faq10"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">

                            <div class="faq-answer">
                                You can contact our customer support team
                                through the contact information provided
                                on our Contact Us page.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>