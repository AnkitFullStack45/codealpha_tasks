@{
    ViewData["Title"] = "Deals";
}
<div class="deals-page">

    <!-- Hero -->
    <section class="deals-hero">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <span class="deal-label">🔥 LIMITED TIME DEALS</span>

                    <h1>
                        Big Deals.<br />
                        <span>Better Prices.</span>
                    </h1>

                    <p>
                        Discover amazing discounts on electronics, fashion,
                        fitness products and more.
                    </p>

                    <a href="#dealProducts" class="btn deal-btn">
                        Shop Deals
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="col-lg-5">
                    <div class="deal-highlight">
                        <span>UP TO</span>
                        <strong>70%</strong>
                        <small>OFF</small>

                        <div class="deal-fire">🔥</div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- Deal Categories -->
    <section class="deal-categories">
        <div class="container">

            <div class="section-heading">
                <span>EXPLORE</span>
                <h2>Deals by Category</h2>
                <p>Find the best offers across your favorite categories.</p>
            </div>

            <div class="row g-4">

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-laptop"></i>
                        <h6>Laptops</h6>
                        <span>Up to 40% Off</span>
                    </a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-phone"></i>
                        <h6>Mobiles</h6>
                        <span>Up to 50% Off</span>
                    </a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-person-standing"></i>
                        <h6>Fashion</h6>
                        <span>Up to 60% Off</span>
                    </a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-heart-pulse"></i>
                        <h6>Fitness</h6>
                        <span>Up to 45% Off</span>
                    </a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-headphones"></i>
                        <h6>Accessories</h6>
                        <span>Up to 55% Off</span>
                    </a>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <a href="#" class="category-card">
                        <i class="bi bi-cup-hot"></i>
                        <h6>Food</h6>
                        <span>Up to 30% Off</span>
                    </a>
                </div>

            </div>
        </div>
    </section>


    <!-- Flash Deals -->
    <section class="flash-deals" id="dealProducts">
        <div class="container">

            <div class="flash-header">

                <div>
                    <span>⚡ FLASH SALE</span>
                    <h2>Today's Best Deals</h2>
                </div>

                <div class="countdown">
                    <small>Ends In</small>

                    <div class="timer">
                        <div>
                            <strong>08</strong>
                            <span>HRS</span>
                        </div>

                        <b>:</b>

                        <div>
                            <strong>24</strong>
                            <span>MIN</span>
                        </div>

                        <b>:</b>

                        <div>
                            <strong>36</strong>
                            <span>SEC</span>
                        </div>
                    </div>
                </div>

            </div>


            <!-- Products -->
            <div class="row g-4">

                <!-- Product 1 -->
                <div class="col-md-6 col-lg-3">
                    <div class="deal-product">

                        <div class="product-image">
                            <span class="discount-badge">-25%</span>

                            <img src="~/Images/HP15Image.jpg"
                                 alt="Laptop"
                                 class="img-fluid">

                            <button class="wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="product-content">

                            <span class="product-category">
                                Electronics
                            </span>

                            <h5>Premium Business Laptop</h5>

                            <div class="rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>

                                <span>(124)</span>
                            </div>

                            <div class="price">
                                <strong>₹54,999</strong>
                                <del>₹72,999</del>
                            </div>

                            <button class="add-cart">
                                <i class="bi bi-cart3"></i>
                                Add to Cart
                            </button>

                        </div>
                    </div>
                </div>


                <!-- Product 2 -->
                <div class="col-md-6 col-lg-3">
                    <div class="deal-product">

                        <div class="product-image">
                            <span class="discount-badge">-35%</span>

                            <img src="~/Images/moto-edge50pro.jpg"
                                 alt="Mobile"
                                 class="img-fluid">

                            <button class="wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="product-content">

                            <span class="product-category">
                                Mobiles
                            </span>

                            <h5>Next Gen Smartphone</h5>

                            <div class="rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>

                                <span>(89)</span>
                            </div>

                            <div class="price">
                                <strong>₹29,999</strong>
                                <del>₹45,999</del>
                            </div>

                            <button class="add-cart">
                                <i class="bi bi-cart3"></i>
                                Add to Cart
                            </button>

                        </div>
                    </div>
                </div>


                <!-- Product 3 -->
                <div class="col-md-6 col-lg-3">
                    <div class="deal-product">

                        <div class="product-image">
                            <span class="discount-badge">-40%</span>

                            <img src="~/Images/headphone.jpg"
                                 alt="Headphones"
                                 class="img-fluid">

                            <button class="wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="product-content">

                            <span class="product-category">
                                Accessories
                            </span>

                            <h5>Wireless Noise Cancelling Headphones</h5>

                            <div class="rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star"></i>

                                <span>(67)</span>
                            </div>

                            <div class="price">
                                <strong>₹3,599</strong>
                                <del>₹5,999</del>
                            </div>

                            <button class="add-cart">
                                <i class="bi bi-cart3"></i>
                                Add to Cart
                            </button>

                        </div>
                    </div>
                </div>


                <!-- Product 4 -->
                <div class="col-md-6 col-lg-3">
                    <div class="deal-product">

                        <div class="product-image">
                            <span class="discount-badge">-30%</span>

                            <img src="~/Images/gymset.jpg"
                                 alt="Gym Equipment"
                                 class="img-fluid">

                            <button class="wishlist">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <div class="product-content">

                            <span class="product-category">
                                Fitness
                            </span>

                            <h5>Professional Dumbbell Set</h5>

                            <div class="rating">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>

                                <span>(152)</span>
                            </div>

                            <div class="price">
                                <strong>₹2,799</strong>
                                <del>₹3,999</del>
                            </div>

                            <button class="add-cart">
                                <i class="bi bi-cart3"></i>
                                Add to Cart
                            </button>

                        </div>
                    </div>
                </div>

            </div>


            <div class="view-all">
                <a href="#" class="view-btn">
                    View All Deals
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>
    </section>

</div>


<style>

    .deals-page {
        background: #f7f9fc;
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
    }

    /* HERO */

    .deals-hero {
        padding: 75px 0;
        background: linear-gradient(135deg, #eef5ff, #ffffff);
        overflow: hidden;
    }

    .deal-label {
        color: #ff6600;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .deals-hero h1 {
        margin-top: 15px;
        font-size: clamp(42px, 6vw, 72px);
        line-height: 1.05;
        font-weight: 800;
        color: #182230;
    }

    .deals-hero h1 span {
        color: #ff6600;
    }

    .deals-hero p {
        max-width: 560px;
        margin: 20px 0 28px;
        color: #667085;
        font-size: 16px;
        line-height: 1.7;
    }

    .deal-btn {
        background: #ff6600;
        color: white;
        padding: 13px 25px;
        border-radius: 10px;
        font-weight: 600;
        border: none;
    }

    .deal-btn:hover {
        background: #e85c00;
        color: white;
        transform: translateY(-2px);
    }

    .deal-highlight {
        width: 280px;
        height: 280px;
        margin: auto;
        border-radius: 50%;
        background: white;
        box-shadow: 0 20px 60px rgba(0,0,0,.10);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    .deal-highlight span {
        color: #667085;
        font-size: 16px;
        font-weight: 600;
    }

    .deal-highlight strong {
        font-size: 70px;
        line-height: 1;
        color: #ff6600;
        font-weight: 800;
    }

    .deal-highlight small {
        font-weight: 700;
        color: #182230;
    }

    .deal-fire {
        position: absolute;
        right: 15px;
        top: 15px;
        font-size: 32px;
    }


    /* CATEGORY */

    .deal-categories {
        padding: 70px 0;
        background: white;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

    .section-heading > span {
        color: #ff6600;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .section-heading h2 {
        margin: 8px 0;
        font-size: 32px;
        font-weight: 750;
        color: #182230;
    }

    .section-heading p {
        color: #667085;
    }

    .category-card {
        display: block;
        text-align: center;
        padding: 25px 10px;
        border: 1px solid #edf0f5;
        border-radius: 16px;
        text-decoration: none;
        color: #182230;
        transition: .25s ease;
    }

    .category-card:hover {
        transform: translateY(-5px);
        border-color: #ff6600;
        box-shadow: 0 12px 30px rgba(0,0,0,.07);
        color: #182230;
    }

    .category-card i {
        font-size: 30px;
        color: #ff6600;
    }

    .category-card h6 {
        margin: 12px 0 5px;
        font-weight: 700;
    }

    .category-card span {
        font-size: 11px;
        color: #667085;
    }


    /* FLASH DEALS */

    .flash-deals {
        padding: 75px 0;
    }

    .flash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .flash-header > div:first-child span {
        color: #ff6600;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .flash-header h2 {
        margin-top: 5px;
        font-size: 32px;
        font-weight: 750;
        color: #182230;
    }

    .countdown {
        text-align: right;
    }

    .countdown small {
        color: #667085;
    }

    .timer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }

    .timer div {
        min-width: 48px;
        padding: 7px;
        text-align: center;
        border-radius: 8px;
        background: #182230;
        color: white;
    }

    .timer strong {
        display: block;
        font-size: 18px;
    }

    .timer span {
        font-size: 8px;
        opacity: .7;
    }

    .timer b {
        color: #182230;
    }


    /* PRODUCT */

    .deal-product {
        background: white;
        border: 1px solid #edf0f5;
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        transition: .25s ease;
    }

    .deal-product:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0,0,0,.09);
    }

    .product-image {
        height: 230px;
        background: #f5f7fa;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .product-image img {
        max-height: 190px;
        object-fit: contain;
        transition: .3s ease;
    }

    .deal-product:hover .product-image img {
        transform: scale(1.06);
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #ff6600;
        color: white;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        z-index: 2;
    }

    .wishlist {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: none;
        background: white;
        color: #667085;
    }

    .wishlist:hover {
        color: #ff6600;
    }

    .product-content {
        padding: 18px;
    }

    .product-category {
        font-size: 11px;
        color: #ff6600;
        font-weight: 600;
    }

    .product-content h5 {
        margin: 7px 0;
        font-size: 15px;
        font-weight: 650;
        min-height: 42px;
        color: #182230;
    }

    .rating {
        font-size: 11px;
        color: #ffb000;
    }

    .rating span {
        color: #98a2b3;
        margin-left: 4px;
    }

    .price {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 14px 0;
    }

    .price strong {
        font-size: 19px;
        color: #182230;
    }

    .price del {
        color: #98a2b3;
        font-size: 12px;
    }

    .add-cart {
        width: 100%;
        border: 1px solid #ff6600;
        background: transparent;
        color: #ff6600;
        border-radius: 8px;
        padding: 9px;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

    .add-cart:hover {
        background: #ff6600;
        color: white;
    }


    /* VIEW ALL */

    .view-all {
        text-align: center;
        margin-top: 40px;
    }

    .view-btn {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        text-decoration: none;
        color: #182230;
        font-weight: 600;
        border-bottom: 2px solid #ff6600;
        padding-bottom: 4px;
    }

    .view-btn:hover {
        color: #ff6600;
    }


    /* RESPONSIVE */

    @@media (max-width: 767px) {

        .deals-hero {
            padding: 55px 0;
            text-align: center;
        }

        .deals-hero p {
            margin-left: auto;
            margin-right: auto;
        }

        .deal-highlight {
            width: 220px;
            height: 220px;
            margin-top: 40px;
        }

        .deal-highlight strong {
            font-size: 55px;
        }

        .flash-header {
            display: block;
        }

        .countdown {
            text-align: left;
            margin-top: 20px;
        }

        .flash-header h2 {
            font-size: 26px;
        }
    }

</style>
