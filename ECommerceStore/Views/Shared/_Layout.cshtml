@using ECommerceStore.Extensions
@using ECommerceStore.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] -AnkitKart </title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/terms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AboutMe.css"asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Sitemap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerceStore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com" asp-append-version="true">
<link rel="preconnect" href="https://fonts.gstatic.com" asp-append-version="true">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" asp-append-version="true">
</head>
<body>
       @{
        var cart = Context.Session.GetObject<List<CartItem>>("Cart")
                   ?? new List<CartItem>();

        var cartCount = cart.Sum(x => x.Quantity);
    }
    <!-- ================= TOP STRIP ================= -->
    <div class="top-strip text-white py-2">
        <div class="container-fluid px-lg-5">
            <div class="row align-items-center">
                <!-- Left -->
                <div class="col-md-4 d-none d-md-block">
                    <i class="fa-solid fa-truck me-2"></i>
                    Free Shipping on Orders Over ₹499
                </div>

                <!-- Center -->
                <div class="col-md-4 text-center">
                    🌟 Mega Sale Up to 60% OFF | Limited Time Offer!
                </div>

                <!-- Right -->
                <div class="col-md-4 text-end d-none d-md-block">

                    <span class="me-4">
                        <i class="fa-solid fa-phone me-1"></i>
                        <a asp-controller="Home" asp-action="ContactUs" class="text-decoration-none text-white">Customer Support </a>  
                    </span>
                    <span>
                        <i class="fa-solid fa-location-dot me-1"></i>
                        Track Order
                    </span>
                </div>
            </div>
        </div>
    </div>
    <!-- ================= MAIN HEADER ================= -->
    <header class="bg-white border-bottom shadow-sm">

        <!-- TOP HEADER -->
        <div class="container-fluid px-lg-5 py-3">

            <div class="row align-items-center g-3">

                <!-- LOGO -->
                <div class="col-lg-2 col-md-3 col-6">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="shop-logo text-decoration-none">

                        <i class="fa-solid fa-bag-shopping"></i>

                        <span style="font-size:25px;">
                            ANKIT<span class="text-primary"> CART</span>
                        </span>

                    </a>

                </div>


                <!-- SEARCH BAR -->
                <div class="col-lg-6 col-md-9 col-12 order-lg-2 order-3">

                    <div class="input-group search-box">

                        <!-- Categories Dropdown -->
                        <div class="category-hover-wrapper">

                            <button class="btn btn-light border dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">

                                All Categories

                            </button>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Laptop">

                                        <i class="fa-solid fa-laptop me-2"></i>
                                        Laptops

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">

                                        <i class="fa-solid fa-dumbbell me-2"></i>
                                        Gym Items

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">

                                        <i class="fa-solid fa-burger me-2"></i>
                                        Food & Beverages

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">

                                        <i class="fa-solid fa-shirt me-2"></i>
                                        Clothes & Fashion

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="#">

                                        <i class="fa-solid fa-headphones me-2"></i>
                                        Electronic Accessories

                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Product" asp-action="Index"> 
                                        <i class="fa-solid fa-list-ul"></i>
                                           All Products

                                    </a>
                                </li>

                            </ul>

                        </div>


                        <!-- Search Input -->
                        <input type="text"
                               class="form-control"
                               placeholder="Search for products, brands and more...">


                        <!-- Search Button -->
                        <button class="btn btn-primary px-4"
                                type="button">

                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>
                <!-- HEADER ICONS -->
                <div class="col-lg-4 col-md-6 col-6 order-lg-3 order-2">
                    <div class="d-flex justify-content-end align-items-center gap-4">
                       <!-- Account -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="text-decoration-none text-dark">
                                <div class="d-flex align-items-center gap-2 header-action">
                                    <i class="fa-solid fa-user fs-4 text-primary"></i>
                                    <div class="d-none d-xl-block">

                                        <small class="d-block text-muted">
                                            Welcome
                                        </small>
                                        <strong class="small">
                                            My Account
                                        </strong>

                                    </div>

                                </div>

                            </a>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 header-action">

                                <i class="fa-regular fa-user fs-4 text-primary"></i>

                                <div class="d-none d-xl-block">

                                    <div class="account-links">

                                        <a asp-controller="Account"
                                           asp-action="Login"
                                           class="account-login-link">
                                            Login
                                        </a>

                                        <span>|</span>

                                        <a asp-controller="Account"
                                           asp-action="Register"
                                           class="account-register-link">
                                            Sign Up
                                        </a>

                                    </div>

                                    <strong class="small text-muted">
                                        My Account
                                    </strong>

                                </div>

                            </div>
                        }
                        <!-- Wishlist -->
                        <div class="text-center header-action position-relative">

                            <div class="position-relative d-inline-block">

                                <i class="fa-regular fa-heart fs-4"></i>

                                <span class="badge-count">
                                    0
                                </span>

                            </div>

                            <span class="d-none d-xl-block small">
                                Wishlist
                            </span>

                        </div>


                        <!-- Cart -->
                <div class="text-center header-action position-relative">

                      <a asp-controller="Cart"
                     asp-action="Index"
                    class="text-decoration-none text-dark">

                   <div class="position-relative d-inline-block">

                      <i class="fa-solid fa-cart-shopping fs-4"></i>

                     <span class="badge-count" id="cartCount">
                            @cartCount
                         </span>

                           </div>

                         <span class="d-none d-xl-block small">
                             Cart
                          </span>

                           </a>
                       </div>
                    </div> 
                </div>
            </div>
        </div>

        <!-- NAVIGATION BAR -->
        <div class="border-top">

            <div class="container-fluid px-lg-5">

                <nav class="navbar navbar-expand-lg py-0">

                    <div class="collapse navbar-collapse show">

                        <ul class="navbar-nav mx-auto gap-lg-4">

                            <!-- HOME -->
                            <li class="nav-item">

                                <a class="nav-link fw-semibold px-3 py-3"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <i class="fa-solid fa-house me-1"></i>
                                    Home

                                </a>

                            </li>


                            <!-- CATEGORIES -->
                            <li class="nav-item">

                                <a class="nav-link fw-semibold px-3 py-3"
                                   asp-controller="Category"
                                   asp-action="Index">

                                    <i class="fa-solid fa-layer-group me-1"></i>
                                    Categories

                                </a>

                            </li>


                            <!-- PRODUCTS -->
                            <li class="nav-item">

                                <a class="nav-link fw-semibold px-3 py-3"
                                   asp-controller="Product"
                                   asp-action="Laptop">

                                    <i class="fa-solid fa-box-open me-1"></i>
                                    Products

                                </a>

                            </li>


                            <!-- DEALS -->
                            <li class="nav-item">

                                <a class="nav-link fw-semibold px-3 py-3"
                                   href="/Home/Deals">

                                    <i class="fa-solid fa-tags me-1"></i>
                                    Deals

                                </a>

                            </li>


                            <!-- ABOUT -->
                            <li class="nav-item">

                                <a class="nav-link fw-semibold px-3 py-3"
                                   asp-controller="Home" asp-action="AboutUs">

                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    About Us

                                </a>

                            </li>

                        </ul>

                    </div>

                </nav>

            </div>

        </div>

    </header>
            <!-- PAGE CONTENT -->
            <main>
                @RenderBody()
            </main>
 <!-- ================= FOOTER ================= -->
<footer class="site-footer">

    <div class="container">

        <!-- Footer Top -->
        <div class="row gy-5">

            <!-- Company -->
            <div class="col-12 col-md-6 col-lg-3">

                <div class="footer-box">

                    <h3 class="footer-logo">
                        <i class="fa-solid fa-bag-shopping"></i>
                        Ankit<span>Kart</span>
                    </h3>

                    <p class="footer-about">
                        Your one-stop destination for electronics,
                        fashion, fitness products, food and much more.
                        Shop smarter and enjoy amazing deals every day.
                    </p>

                    <div class="social-icons">

                            <a href="https://www.facebook.com/profile.php?id=100058583382902" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                            <a href="https://www.instagram.com/mr.ankit_baghel45?igsi=MXdyOWZrcG40cDZvZg==" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>

                            <a href="https://x.com/MrAnkitkumar24" aria-label="Twitter">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>

                            <a href="https://youtube.com/moodyboys45?si=zJzIL29LHXBRX286" aria-label="YouTube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- Shop -->
            <div class="col-6 col-md-6 col-lg-2">

                <div class="footer-box">

                    <h5>Shop</h5>

                    <ul class="footer-links">

                        <li><a href="/Product/Laptop">Laptops</a></li>
                        <li><a href="#">Mobiles</a></li>
                        <li><a href="#">Gym Items</a></li>
                        <li><a href="#">Fashion</a></li>
                        <li><a href="#">Food & Beverages</a></li>

                    </ul>

                </div>

            </div>


            <!-- Customer Service -->
            <div class="col-6 col-md-6 col-lg-2">

                <div class="footer-box">

                    <h5>Customer Service</h5>

                    <ul class="footer-links">

                            <li><a href="/Home/ContactUs">Contact Us</a></li>
                        <li><a href="#">Track Order</a></li>
                        <li><a href="/Home/ShippingPolicy">Shipping Policy</a></li>
                        <li><a href="/Home/ReturnPolicy">Return Policy</a></li>
                        <li><a href="/Home/Faq">FAQ</a></li>

                    </ul>

                </div>

            </div>


            <!-- My Account -->
            <div class="col-6 col-md-6 col-lg-2">

                <div class="footer-box">

                    <h5>My Account</h5>

                    <ul class="footer-links">

                        <li><a href="/Accout/Profile">My Profile</a></li>
                        <li><a href="/Order/Index">My Orders</a></li>
                        <li><a href="/Cart/Index">Cart</a></li>
                        <li><a href="/Account/Login">Login</a></li>
                    </ul>
                </div>
            </div>   
            <!-- Contact -->
            <div class="col-12 col-md-6 col-lg-3">

                <div class="footer-box">

                    <h5>Contact Us</h5>

                    <div class="footer-contact">

                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Agra, Uttar Pradesh, India</span>
                        </p>

                        <p>
                            <i class="fa-solid fa-phone"></i>
                            <a href="tel:+91952045038">+91 9520452038</a>
                        </p>

                        <p>
                            <i class="fa-solid fa-envelope"></i>
                                <a href="mailto:ankitk66135@gmail.com">support@ankitkart.com</a>
                        </p>

                        <p>
                            <i class="fa-solid fa-clock"></i>
                            <span>Mon - Sat: 9:00 AM - 8:00 PM</span>
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <!-- Newsletter -->
        <div class="footer-newsletter">

            <div class="row align-items-center gy-3">

                <div class="col-12 col-lg-6">

                    <h4>Subscribe to our Newsletter</h4>

                    <p>
                        Get updates about new products, exclusive deals
                        and special offers.
                    </p>
                </div>

                <div class="col-12 col-lg-6">

                    <form class="newsletter-form">

                        <input type="email"
                               placeholder="Enter your email address"
                               required />

                        <button type="submit">
                            Subscribe
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- Payment Methods -->
        <div class="payment-section">

            <p>Secure Payments</p>

            <div class="payment-icons">

                <span><i class="fa-brands fa-cc-visa"></i></span>
                <span><i class="fa-brands fa-cc-mastercard"></i></span>
                <span><i class="fa-brands fa-cc-amex"></i></span>
                <span><i class="fa-brands fa-cc-paypal"></i></span>
                <span><i class="fa-brands fa-google-pay"></i></span>
            </div>
        </div>
        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <p>
                © @DateTime.Now.Year AnkitKart. All Rights Reserved.
            </p>
            <div class="footer-bottom-links">
                <a href="/Home/Privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/Terms" class="text-decoration-none">Terms & Conditions</a>
                <a href="/Home/SiteMap" class="text-decoration-none">Sitemap</a>
            </div>
        </div>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="https://www.google.com/recaptcha/api.js"
        async
        defer></script>

<script src="~/js/PopUp.js" asp-append-version="true"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
