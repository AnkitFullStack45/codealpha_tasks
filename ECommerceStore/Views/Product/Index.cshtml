@model IEnumerable<ECommerceStore.Models.Product>
@{
    ViewData["Title"] = "Products";
}
<!-- ================= SUCCESS MESSAGE ================= -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert"
         id="SuccessMessage">

        <strong>Success!</strong>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>

    </div>
}
<!-- ================= PRODUCTS ================= -->
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            Products
        </h2>

        <a asp-action="Create"
           class="btn btn-primary rounded-pill px-4">

            <i class="fas fa-plus me-2"></i>
            Add Product

        </a>
    </div>
    <!-- ================= PRODUCT GRID ================= -->
    <div class="row g-4">

        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">

                <div class="card product-card h-100 border-0 rounded-4 overflow-hidden">
                    <!-- ================= IMAGE ================= -->

                    <div class="product-image-container">

                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@Url.Content("~/Images/" + product.ImageUrl)"
                                 alt="@product.Name"
                                 class="product-image" />
                        }
                        else
                        {
                            <div class="no-image">

                                <i class="fas fa-image"></i>

                                <span>
                                    No Image
                                </span>

                            </div>
                        }

                    </div>


                    <!-- ================= PRODUCT BODY ================= -->

                    <div class="card-body d-flex flex-column">


                        <!-- Product Name -->

                        <h5 class="product-title">
                            @product.Name
                        </h5>


                        <!-- Brand -->
                        @if (!string.IsNullOrEmpty(product.Brand))
                        {
                            <p class="product-brand">
                                @product.Brand
                            </p>
                        }


                        <!-- Price -->

                        <h5 class="product-price">
                            ₹@product.Price.ToString("N0")
                        </h5>


                        <!-- Description -->

                        <p class="product-description">

                            @product.Description

                        </p>


                        <!-- ================= BUTTONS ================= -->

                        <div class="mt-auto pt-3 border-top">

                            <div class="d-flex justify-content-between align-items-center">


                                <!-- View -->

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-dark rounded-pill px-3">

                                    <i class="fas fa-eye me-1"></i>

                                    View

                                </a>


                                <!-- Edit -->

                                <a asp-controller="Product"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="edit-product">

                                    <i class="fas fa-pen me-1"></i>

                                    Edit

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>


<!-- ================= CSS ================= -->

<style>

    /* Product Card */

    .product-card {
        background: #ffffff;
        transition: all 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.10);
        }


    /* Product Image */

    .product-image-container {
        width: 100%;
        height: 230px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 15px;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }


    /* No Image */

    .no-image {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #999;
        gap: 8px;
    }

        .no-image i {
            font-size: 40px;
        }


    /* Product Title */

    .product-title {
        font-size: 17px;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 6px;
    }


    /* Brand */

    .product-brand {
        color: #777;
        font-size: 14px;
        margin-bottom: 8px;
    }


    /* Price */

    .product-price {
        color: #0d6efd;
        font-weight: 700;
        margin-bottom: 10px;
    }


    /* Description */

    .product-description {
        color: #666;
        font-size: 13px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 10px;
    }


    /* Edit Link */

    .edit-product {
        color: #333;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        transition: 0.2s ease;
    }

        .edit-product:hover {
            color: #0d6efd;
        }


    /* Success Message */

    #SuccessMessage {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 9999;
        min-width: 300px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }


    /* Mobile */

    @@media (max-width: 576px) {

        .product-image-container {
            height: 250px;
        }

        #SuccessMessage {
            left: 15px;
            right: 15px;
            min-width: auto;
        }
    }

</style>
