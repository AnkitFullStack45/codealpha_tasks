@{
    ViewData["Title"] = "Registration Confirmation";
}

<style>
    .confirmation-page {
        min-height: 82vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 15px;
        background: radial-gradient(circle at top left, rgba(255, 102, 0, 0.10), transparent 35%), radial-gradient(circle at bottom right, rgba(255, 102, 0, 0.08), transparent 35%), #f8fafc;
    }

    .confirmation-card {
        position: relative;
        width: 100%;
        max-width: 560px;
        padding: 48px 45px;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.10);
        text-align: center;
        overflow: hidden;
    }

        .confirmation-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #ff6600, #ff8533);
        }

    .success-icon {
        width: 95px;
        height: 95px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: linear-gradient( 135deg, rgba(255, 102, 0, 0.12), rgba(255, 133, 51, 0.06) );
        border: 1px solid rgba(255, 102, 0, 0.15);
        box-shadow: 0 10px 30px rgba(255, 102, 0, 0.10);
    }

        .success-icon i {
            font-size: 42px;
            color: #ff6600;
        }

    .confirmation-title {
        font-size: 30px;
        font-weight: 700;
        color: #172033;
        margin-bottom: 12px;
    }

    .confirmation-text {
        color: #687386;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 0;
    }

    .steps-box {
        margin: 28px 0;
        padding: 20px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 18px;
        text-align: left;
    }

    .step {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .step:not(:last-child) {
            margin-bottom: 18px;
        }

    .step-icon {
        min-width: 38px;
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: rgba(255, 102, 0, 0.10);
        color: #ff6600;
    }

    .step-content strong {
        display: block;
        color: #202938;
        font-size: 14px;
        margin-bottom: 2px;
    }

    .step-content span {
        color: #7b8494;
        font-size: 13px;
    }

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        margin-bottom: 25px;
        background: #fff8f3;
        border: 1px solid #ffe5d5;
        border-radius: 14px;
        text-align: left;
        color: #6d625b;
        font-size: 13px;
        line-height: 1.5;
    }

        .info-box i {
            color: #ff6600;
            font-size: 16px;
            margin-top: 2px;
        }

    .login-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        padding: 13px 22px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #ff6600, #ff7a1a);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 10px 22px rgba(255, 102, 0, 0.20);
        transition: all 0.25s ease;
    }

        .login-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(255, 102, 0, 0.28);
        }

    .bottom-text {
        margin-top: 18px;
        color: #9299a6;
        font-size: 12px;
    }

    .brand-name {
        color: #ff6600;
        font-weight: 700;
    }

    @@media (max-width: 576px) {
        .confirmation-page {
            padding: 30px 15px;
        }

        .confirmation-card {
            padding: 38px 22px;
            border-radius: 22px;
        }

        .confirmation-title {
            font-size: 25px;
        }

        .success-icon {
            width: 80px;
            height: 80px;
        }

            .success-icon i {
                font-size: 35px;
            }
    }
</style>

<div class="confirmation-page">

    <div class="confirmation-card">

        <!-- Success Icon -->
        <div class="success-icon">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <!-- Heading -->
        <h1 class="confirmation-title">
            Registration Successful!
        </h1>

        <p class="confirmation-text">
            Welcome to <span class="brand-name">AnkitKart</span>.
            Your account has been created successfully.
        </p>

        <p class="confirmation-text">
            We've sent a confirmation link to your email address.
            Please verify your email before logging in.
        </p>


        <!-- Steps -->
        <div class="steps-box">

            <div class="step">

                <div class="step-icon">
                    <i class="fa-solid fa-user-check"></i>
                </div>

                <div class="step-content">
                    <strong>Account Created</strong>
                    <span>Your AnkitKart account is ready.</span>
                </div>

            </div>


            <div class="step">

                <div class="step-icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div class="step-content">
                    <strong>Check Your Email</strong>
                    <span>Open the confirmation email we sent you.</span>
                </div>

            </div>


            <div class="step">

                <div class="step-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div class="step-content">
                    <strong>Confirm Your Email</strong>
                    <span>Click the confirmation link to activate your account.</span>
                </div>

            </div>

        </div>


        <!-- Spam Info -->
        <div class="info-box">

            <i class="fa-solid fa-circle-info"></i>

            <span>
                Didn't receive the email?
                Please check your <strong>Spam</strong> or
                <strong>Junk</strong> folder.
            </span>

        </div>


        <!-- Login Button -->
        <a asp-controller="Account"
           asp-action="Login"
           class="login-btn">

            <i class="fa-solid fa-right-to-bracket"></i>

            Go to Login

        </a>


        <div class="bottom-text">
            Secure shopping starts with a verified account.
        </div>

    </div>

</div>