@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="forgot-confirmation-page">
    <div class="forgot-confirmation-card">

        <div class="confirmation-icon">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <h2>Check Your Email 📩</h2>

        <p class="confirmation-text">
            If an account exists with the email address you entered,
            we have sent you a password reset link.
        </p>

        <p class="confirmation-subtext">
            Please check your inbox and follow the instructions
            to create a new password.
        </p>

        <div class="confirmation-actions">

            <a asp-controller="Account"
               asp-action="Login"
               class="btn-back-login">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Login
            </a>

        </div>

        <div class="spam-message">
            <i class="fa-solid fa-circle-info"></i>
            Didn't receive the email? Check your spam or junk folder.
        </div>

    </div>
</div>
