@model ECommerceStore.ViewModels.LoginViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Login";
}
<div class="account-login-page">

    <div class="account-login-container">

        <div class="account-login-card">
            <!-- =====================================================
                 LOGIN HEADER
                 ===================================================== -->
            <div class="account-login-header">

                <div class="account-login-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <h1>Welcome Back</h1>

                <p>
                    Login to your ANKIT CART account
                </p>

            </div>
            <!-- =====================================================
                 ERROR MESSAGE
                 ===================================================== -->
            @if (ViewBag.Error != null)
            {
                <div class="account-login-error">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <span>
                        @ViewBag.Error
                    </span>

                </div>
            }
            <!-- =====================================================
                 VALIDATION SUMMARY
                 ===================================================== -->
            <div asp-validation-summary="All"
                 class="account-validation">
            </div>
            <!-- =====================================================
                 LOGIN FORM
                 ===================================================== -->

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="account-login-form">

                @Html.AntiForgeryToken()


                <!-- =================================================
                     EMAIL
                     ================================================= -->

                <div class="account-field">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="account-input">

                        <i class="fa-regular fa-envelope"></i>

                        <input asp-for="Email"
                               placeholder="Enter your email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email"
                          class="account-field-error">
                    </span>

                </div>


                <!-- =================================================
                     PASSWORD
                     ================================================= -->

                <div class="account-field">

                    <label asp-for="Password">
                        Password
                    </label>

                    <div class="account-input">

                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="Password"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="account-field-error">
                    </span>

                </div>


                <!-- =================================================
                     FORGOT PASSWORD
                     ================================================= -->

                <div class="account-forgot-password">
                    <a asp-controller="Account" class="text-decoration-none"
                       asp-action="ForgotPassword">
                        Forgot Password?
                    </a>
                </div>


                <!-- =================================================
                     REMEMBER ME
                     ================================================= -->
                <div class="account-remember">

                    <label>

                        <input asp-for="RememberMe" />

                        <span>
                            Remember me
                        </span>

                    </label>

                </div>

                <br />
                <!-- =================================================
                     LOGIN BUTTON
                     ================================================= -->
                <button type="button"
                        class="account-login-button"
                        data-bs-toggle="modal"
                        data-bs-target="#captchaModal">

                    <span>Login</span>

                    <i class="fa-solid fa-arrow-right"></i>

                </button>
            </form>
            <!-- =====================================================
                 REGISTER
                 ===================================================== -->
            <div class="account-register">
                <span>
                    Don't have an account?
                </span>
                <a asp-controller="Account" class="text-decoration-none"
                   asp-action="Register">
                    Create Account
                </a>
            </div>
        </div>
    </div>
</div>
<!-- ============================================================= CAPTCHA MODAL IMPORTANT: OUTSIDE LOGIN FORM ============================================================= -->

<partial name="_CaptchaModal" />

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
<style>
    .account-forgot-password {
    text-align: right;
    margin-top: -8px;
    margin-bottom: 18px;
}

.account-forgot-password a {
    color: #0d6efd;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
}

.account-forgot-password a:hover {
    color: #084298;
    text-decoration: underline;
}
</style>

