@model ECommerceStore.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
<div class="profile-page">
    <div class="profile-container">
        <div class="profile-heading">
            <div>
                <h1>My Profile</h1>

                <p class="text-center text-dark fw-bold">
                    Manage your personal information
                </p>
            </div>

        </div>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i>
                @TempData["Success"]
            </div>
        }


        <div class="profile-card">

            <form asp-controller="Account"
                  asp-action="Profile"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- PROFILE PICTURE -->

                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl"
                             class="profile-image"
                             alt="Profile Picture" />
                    }
                    else
                    {
                        <div class="profile-image-placeholder">

                            <i class="fa-solid fa-user"></i>

                        </div>
                    }

                    <div class="mt-3">

                        <label class="form-label fw-semibold">
                            Profile Picture
                        </label>

                        <input asp-for="ProfileImage"
                               type="file"
                               class="form-control"
                               accept="image/*" />

                        <span class="text-muted small">
                            Choose a JPG, PNG or other image.
                        </span>

                    </div>

                </div>


                <!-- FULL NAME -->

                <div class="mb-3">

                    <label asp-for="FullName"
                           class="form-label fw-semibold">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control"
                           placeholder="Enter your full name" />

                    <span asp-validation-for="FullName"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />

                </div>


                <!-- PHONE -->

                <div class="mb-3">

                    <label asp-for="PhoneNumber"
                           class="form-label fw-semibold">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="Enter your phone number" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger">
                    </span>

                </div>


                <!-- ADDRESS -->

                <div class="mb-4">

                    <label asp-for="Address"
                           class="form-label fw-semibold">
                        Address
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="4"
                              placeholder="Enter your complete address">
                    </textarea>

                </div>


                <!-- BUTTONS -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>

                        Save Changes

                    </button>


                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Continue Shopping

                    </a>

                </div>

            </form>
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-dark btn-lg mt-3">

                    <i class="fa-solid fa-right-from-bracket me-1"></i>
                    Logout

                </button>

            </form>
        </div>

    </div>

</div>

