@using ECommerceStore.Models

@{
    ViewData["Title"] = "Checkout";

    var cart = ViewBag.Cart as List<CartItem>
               ?? new List<CartItem>();

    decimal total = cart.Sum(x => x.TotalPrice);
}

<div class="checkout-page">

    <!-- HEADER -->

    <div class="checkout-header">

        <h1>
            Checkout
        </h1>

        <p>
            Complete your order by providing your details
        </p>

    </div>


    <div class="checkout-layout">

        <!-- =========================
             CUSTOMER INFORMATION
             ========================= -->

        <div class="checkout-form-card">

            <div class="form-card-header">

                <div class="header-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <h2>
                        Customer Information
                    </h2>

                    <p>
                        Enter your delivery details
                    </p>
                </div>

            </div>


            <form asp-action="PlaceOrder"
                  asp-controller="Checkout"
                  method="post">


                <!-- NAME -->

                <div class="form-group">

                    <label>
                        Full Name
                    </label>

                    <input type="text"
                           name="CustomerName"
                           class="form-control"
                           placeholder="Enter your full name"
                           required>

                </div>


                <!-- EMAIL -->

                <div class="form-group">

                    <label>
                        Email Address
                    </label>

                    <input type="email"
                           name="CustomerEmail"
                           class="form-control"
                           placeholder="Enter your email address"
                           required>

                </div>


                <!-- ADDRESS -->

                <div class="form-group">

                    <label>
                        Shipping Address
                    </label>

                    <textarea name="ShippingAddress"
                              class="form-control"
                              rows="4"
                              placeholder="Enter your complete shipping address"
                              required></textarea>

                </div>


                <!-- PAYMENT -->

                <div class="payment-box">
                    <div class="payment-icon">
                        <i class="fa-solid fa-credit-card"></i>
                    </div>
                    <div>
                        <strong>
                            Cash on Delivery
                        </strong>

                        <p>
                            Pay when your order arrives
                        </p>

                    </div>

                </div>


                <!-- PLACE ORDER -->

                <button type="submit"
                        class="place-order-btn">

                    Place Order

                    <i class="fa-solid fa-arrow-right"></i>

                </button>


            </form>

        </div>


        <!-- =========================
             ORDER SUMMARY
             ========================= -->

        <div class="checkout-summary">

            <div class="summary-card">

                <h2>
                    Order Summary
                </h2>


                <!-- PRODUCTS -->

                <div class="checkout-products">

                    @foreach (var item in cart)
                    {
                        <div class="checkout-product">

                            <div class="checkout-product-image">

                             <img src="~/images/@item.ImageUrl"
                               alt="@item.ProductName">

                            </div>

                            <div class="checkout-product-info">

                                <h4>
                                    @item.ProductName
                                </h4>

                                <span>
                                    Qty: @item.Quantity
                                </span>

                            </div>

                            <strong>
                                ₹@item.TotalPrice.ToString("N0")
                            </strong>

                        </div>
                    }

                </div>


                <div class="summary-divider"></div>


                <!-- SUBTOTAL -->

                <div class="summary-row">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@total.ToString("N0")
                    </strong>

                </div>


                <!-- DELIVERY -->

                <div class="summary-row">

                    <span>
                        Delivery
                    </span>

                    <strong class="free">
                        FREE
                   </strong>
                </div>
                <div class="summary-divider"></div>
                <!-- TOTAL -->

                <div class="checkout-total">
                    <span>
                        Total
                    </span>
                    <strong>
                        ₹@total.ToString("N0")
                    </strong>
                </div>
            </div>
        </div>
    </div>
</div>

