@model IEnumerable<ECommerceStore.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container-fluid py-5 px-lg-5">

    <!-- HEADER -->

    <div class="mb-4">

        <h1 class="fw-bold">
            My Orders
        </h1>

        <p class="text-muted">
            View and track all your orders
        </p>

    </div>


    @if (!Model.Any())
    {
        <!-- EMPTY -->

        <div class="text-center py-5">

            <div class="mb-3">
                <i class="fa-solid fa-box-open"
                   style="font-size:60px;color:#0d6efd;">
                </i>
            </div>

            <h3>
                No Orders Yet
            </h3>

            <p class="text-muted">
                You haven't placed any orders yet.
            </p>

            <a asp-controller="Product"
               asp-action="Laptop"
               class="btn btn-primary">

                Start Shopping

            </a>

        </div>
    }
    else
    {
        <!-- ORDERS -->

        <div class="orders-card">

            @foreach (var order in Model)
            {
                <div class="order-row">

                    <!-- ORDER NUMBER -->

                    <div class="order-info">

                        <span class="label">
                            Order
                        </span>

                        <strong>
                            #@order.Id
                        </strong>

                    </div>


                    <!-- DATE -->

                    <div class="order-info">

                        <span class="label">
                            Order Date
                        </span>

                        <strong>
                            @order.OrderDate.ToString("dd MMM yyyy")
                        </strong>

                    </div>


                    <!-- TOTAL -->

                    <div class="order-info">

                        <span class="label">
                            Total
                        </span>

                        <strong class="price">
                            ₹@order.TotalAmount.ToString("N0")
                        </strong>

                    </div>


                    <!-- STATUS -->

                    <div class="order-info">

                        <span class="label">
                            Status
                        </span>

                        <span class="status">
                            @order.Status
                        </span>

                    </div>


                    <!-- DETAILS -->

                    <div>

                        <a asp-controller="Order"
                           asp-action="Details"
                           asp-route-id="@order.Id"
                           class="details-btn">

                            View Details

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>
