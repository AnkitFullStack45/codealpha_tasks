<!-- ================= ANKITKART ================= -->
<section class="about-section ankitkart-section" id="ankitkart">
    <div class="about-container">

        <div class="section-heading">
            <span>04</span>
            <h2>AnkitKart</h2>
            <p>The project I am building.</p>
        </div>

        <div class="ankitkart-intro glass-card">

            <div class="ankitkart-logo">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>

            <div>
                <h3>AnkitKart Shopping Website</h3>

                <p>
                    AnkitKart is a modern e-commerce platform created to
                    provide an online shopping experience while demonstrating
                    real-world ASP.NET Core development concepts.
                </p>

                <p>
                    The project combines backend development, database
                    management, authentication, product management,
                    shopping-cart functionality and modern frontend design.
                </p>
            </div>

        </div>


        <div class="feature-grid">

            <div class="feature-card glass-card">
                <i class="fa-solid fa-box-open"></i>
                <h3>Products</h3>
                <p>
                    Manage products, prices, stock, descriptions and images.
                </p>
            </div>

            <div class="feature-card glass-card">
                <i class="fa-solid fa-list"></i>
                <h3>Categories</h3>
                <p>
                    Organize products into different shopping categories.
                </p>
            </div>

            <div class="feature-card glass-card">
                <i class="fa-solid fa-cart-shopping"></i>
                <h3>Shopping Cart</h3>
                <p>
                    Add products to the cart and manage selected items.
                </p>
            </div>

            <div class="feature-card glass-card">
                <i class="fa-solid fa-user-shield"></i>
                <h3>Authentication</h3>
                <p>
                    User registration, login and role-based access.
                </p>
            </div>

            <div class="feature-card glass-card">
                <i class="fa-solid fa-image"></i>
                <h3>Product Images</h3>
                <p>
                    Upload and display product images throughout the store.
                </p>
            </div>

            <div class="feature-card glass-card">
                <i class="fa-solid fa-mobile-screen"></i>
                <h3>Responsive Design</h3>
                <p>
                    Designed to provide a smooth experience across devices.
                </p>
            </div>

        </div>
    </div>
</section>


